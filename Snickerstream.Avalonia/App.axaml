<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SnickerstreamV2.App"
             Name="3DSnickerStream"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Palette ported verbatim from the WPF Theme.xaml. -->
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#1C1C24" Offset="0"/>
            <GradientStop Color="#131318" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrandBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#6638D9" Offset="0"/>
            <GradientStop Color="#EB4785" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BrandStartBrush" Color="#6638D9"/>
        <SolidColorBrush x:Key="BrandEndBrush" Color="#EB4785"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="SliderTintBrush" Color="#A840B3"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3FFFFFF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF453A"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="FieldHoverBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="StageBackgroundBrush" Color="#FF0C0C10"/>

        <!-- ===== Fluent control overrides: match TextBox/ComboBox to the app's field style ===== -->
        <!-- Rounded corners for inputs, buttons and their popups. -->
        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

        <!-- Compact control metrics (the Fluent defaults are 32px-tall controls and a 20px slider
             thumb inside a 32px lane — the main source of the bulky look). -->
        <x:Double x:Key="ComboBoxMinHeight">26</x:Double>
        <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
        <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
        <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
        <GridLength x:Key="SliderPreContentMargin">0</GridLength>
        <GridLength x:Key="SliderPostContentMargin">0</GridLength>

        <!-- TextBox surfaces (normal / hover / focus) + brand-tinted focus border. -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#B36638D9"/>
        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#805A2AD0"/>

        <!-- ComboBox closed surfaces. -->
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#2EFFFFFF"/>

        <!-- ComboBox dropdown popup + item states (brand-tinted selection, no teal). -->
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF1B1B23"/>
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#3A6638D9"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#3A6638D9"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#4D6638D9"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#4D6638D9"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Theme.axaml"/>
    </Application.Styles>
</Application>
