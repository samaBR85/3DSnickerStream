<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Pure net8.0 (NOT net8.0-windows): this project must build for win/linux/osx. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>3DSnickerStream</AssemblyName>
    <!-- Not "Snickerstream.Avalonia": a namespace segment named Avalonia would shadow the framework's
         root namespace inside our code (classic C# name-resolution footgun). -->
    <RootNamespace>SnickerstreamV2</RootNamespace>
    <Version>2.7.0</Version>
    <Product>3DSnickerStream</Product>
    <ApplicationIcon>..\AppIcon.ico</ApplicationIcon>
    <!-- Code-behind style port (like the WPF app); compiled bindings would demand x:DataType everywhere. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- GPU upscaling: pointer to the pinned frame buffer for SKImage.FromPixels. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Neural ("AI") upscaler: ONNX Runtime + DirectML — Windows-only (DirectML is a DX12 API). The app is
       cross-platform, so the package, the embedded model, and every NeuralUpscaler.cs call site are compiled
       ONLY on Windows, gated by the WINDOWS_NEURAL constant. Linux/macOS builds omit them entirely. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS_NEURAL</DefineConstants>
    <!-- ONNX Runtime / DirectML ship native dlls; bundle them inside the single-file exe (self-extracted
         at launch) so no loose dlls are needed next to it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- All Avalonia packages MUST share the same version. -->
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <!-- GPU upscaling via the Skia lease (ISkiaSharpApiLeaseFeature + SKRuntimeEffect). MUST match the
         SkiaSharp that Avalonia.Skia 11.3.2 bundles (2.88.9) so our SKImage/SKShader share type identity
         with the leased SKCanvas — never 3.x until Avalonia itself moves. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window/taskbar icon (the exe icon comes from ApplicationIcon above). -->
    <AvaloniaResource Include="..\AppIcon.ico" Link="AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Anime4K GPU shaders (bloc97, MIT) — converted to SkSL at runtime for the "Anime4K CNN" filters. -->
    <EmbeddedResource Include="Assets\Anime4K_Upscale_CNN_x2_S.glsl" />
    <EmbeddedResource Include="Assets\Anime4K_Upscale_CNN_x2_M.glsl" />
    <EmbeddedResource Include="Assets\Anime4K_Upscale_CNN_x2_L.glsl" />
    <EmbeddedResource Include="Assets\Anime4K_Upscale_CNN_x2_VL.glsl" />
    <EmbeddedResource Include="Assets\Anime4K_Restore_CNN_S.glsl" />
    <EmbeddedResource Include="Assets\Anime4K_Restore_CNN_M.glsl" />
    <EmbeddedResource Include="Assets\Anime4K_Restore_CNN_L.glsl" />
    <EmbeddedResource Include="Assets\Anime4K_Restore_CNN_VL.glsl" />
  </ItemGroup>

  <ItemGroup>
    <!-- OCR ("copy text from the stream"): Tesseract for both general and hex modes (cross-platform;
         the Windows-only Windows.Media.Ocr is not used). Native leptonica/tesseract libs ship per RID. -->
    <PackageReference Include="TesseractOCR" Version="5.3.5" />
  </ItemGroup>

  <!-- Neural upscaler (Windows-only) — see the WINDOWS_NEURAL PropertyGroup above. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    <!-- Real-ESRGAN Compact (realesr-general-x4v3, SRVGGNetCompact, x4, BSD-3-Clause) — embedded so the
         neural filter works out of the box. Its built-in denoise also suits the compressed NTR stream. -->
    <EmbeddedResource Include="Assets\realesr-general-x4v3.onnx" />
  </ItemGroup>

  <ItemGroup>
    <!-- English trained data, shipped next to the exe under tessdata/. -->
    <Content Include="tessdata\eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tessdata\eng.traineddata</Link>
    </Content>
  </ItemGroup>

  <!-- TesseractOCR's native dlls land in bin\x64 at build but aren't copied to the single-file publish
       folder (its loader looks in <exe>\x64). Copy them there after a Windows publish. On linux/osx the
       item group is empty and OCR gracefully reports "unavailable". -->
  <Target Name="CopyTesseractNatives" AfterTargets="Publish">
    <ItemGroup>
      <_TessNative Include="$(OutDir)x64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_TessNative)" DestinationFolder="$(PublishDir)x64" SkipUnchangedFiles="true"
          Condition="'@(_TessNative)' != ''" />
  </Target>

</Project>
