<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Text helpers ===================== -->
    <Style Selector="TextBlock.caption">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.value">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== Compact inputs ===================== -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="24"/>
    </Style>

    <!-- ===================== Card ===================== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- ===================== Buttons ===================== -->
    <!-- Base tweaks shared by our custom buttons. -->
    <Style Selector="Button.brand, Button.ghost, Button.danger">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Brand (gradient, capsule) -->
    <Style Selector="Button.brand">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="22,8"/>
        <Setter Property="CornerRadius" Value="17"/>
    </Style>
    <Style Selector="Button.brand /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="CornerRadius" Value="17"/>
    </Style>
    <Style Selector="Button.brand:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="Opacity" Value="0.92"/>
    </Style>
    <Style Selector="Button.brand:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="Opacity" Value="0.82"/>
    </Style>

    <!-- Ghost (subtle field-like) -->
    <Style Selector="Button.ghost">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource FieldHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
    </Style>
    <!-- Selected/active ghost (e.g. the chosen protocol or priority screen): brand-tinted. -->
    <Style Selector="Button.ghost.selected">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.ghost.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#3D6638D9"/>
        <Setter Property="BorderBrush" Value="#996638D9"/>
    </Style>
    <Style Selector="Button.ghost.selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#526638D9"/>
        <Setter Property="BorderBrush" Value="#B36638D9"/>
    </Style>

    <!-- Danger (translucent red) -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="#FF6B61"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FF453A"/>
        <Setter Property="BorderBrush" Value="#55FF453A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#44FF453A"/>
        <Setter Property="BorderBrush" Value="#77FF453A"/>
    </Style>

    <!-- ===================== Stream stage ===================== -->
    <!-- Each 3DS screen: rounded frame + hairline border + soft drop shadow.
         Lives inside a Viewbox, so radius/shadow scale with the fit. -->
    <Style Selector="Border.screen">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background" Value="#FF000000"/>
        <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="0 5 22 0 #A6000000"/>
    </Style>

    <!-- Per-screen color adjustment panel (floats over the stage). -->
    <Style Selector="Border.adjust">
        <Setter Property="Background" Value="#CC161620"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Width" Value="196"/>
    </Style>

    <!-- Grouped control cluster in the bottom bar. -->
    <Style Selector="Border.controlgroup">
        <Setter Property="Background" Value="#12FFFFFF"/>
        <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- ===================== Tooltip ===================== -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#FF20202A"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MaxWidth" Value="320"/>
    </Style>

    <!-- ===================== Slider tint ===================== -->
    <Style Selector="Slider /template/ Track /template/ RepeatButton#PART_DecreaseButton /template/ Border">
        <Setter Property="Background" Value="{StaticResource SliderTintBrush}"/>
    </Style>

</Styles>
