<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SnickerstreamV2.Views.StreamView">
    <Grid RowDefinitions="*,Auto">

        <!-- Stage -->
        <Panel Grid.Row="0" Background="{StaticResource StageBackgroundBrush}" ClipToBounds="True">
            <Panel x:Name="ScreensHost" Margin="24"/>
        </Panel>

        <!-- Control bar -->
        <Border Grid.Row="1" Background="#E6141418" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="BtnDisconnect" Classes="danger" Content="Disconnect"/>
                <Border Width="1" Height="24" Background="{StaticResource CardBorderBrush}" Margin="4,0"/>

                <TextBlock Text="Layout" Classes="caption"/>
                <ComboBox x:Name="CmbLayout" MinWidth="120">
                    <ComboBoxItem>Stacked</ComboBoxItem>
                    <ComboBoxItem>Side by side</ComboBoxItem>
                    <ComboBoxItem>Top only</ComboBoxItem>
                    <ComboBoxItem>Bottom only</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Filter" Classes="caption"/>
                <ComboBox x:Name="CmbFilter" MinWidth="100">
                    <ComboBoxItem>Sharp</ComboBoxItem>
                    <ComboBoxItem>Linear</ComboBoxItem>
                    <ComboBoxItem>Smooth</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Rot" Classes="caption"/>
                <ComboBox x:Name="CmbRot" MinWidth="80">
                    <ComboBoxItem>0°</ComboBoxItem>
                    <ComboBoxItem>90°</ComboBoxItem>
                    <ComboBoxItem>180°</ComboBoxItem>
                    <ComboBoxItem>270°</ComboBoxItem>
                </ComboBox>

                <Border Width="1" Height="24" Background="{StaticResource CardBorderBrush}" Margin="4,0"/>
                <Ellipse x:Name="FpsDot" Width="9" Height="9" Fill="#888" VerticalAlignment="Center"/>
                <TextBlock x:Name="FpsBadge" Text="0 / 0 fps" Classes="value"/>
                <TextBlock x:Name="StatusText" Text="Streaming" Classes="caption"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
