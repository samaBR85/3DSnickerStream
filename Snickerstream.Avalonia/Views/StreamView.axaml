<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SnickerstreamV2.Views.StreamView">
    <Grid RowDefinitions="*,Auto">

        <!-- Stage -->
        <Panel x:Name="Stage" Grid.Row="0" ClipToBounds="True">
            <Panel.Background>
                <RadialGradientBrush Center="50%,40%" GradientOrigin="50%,40%"
                                     RadiusX="72%" RadiusY="72%">
                    <GradientStop Color="#FF20202C" Offset="0"/>
                    <GradientStop Color="#FF14141B" Offset="0.55"/>
                    <GradientStop Color="#FF0A0A0E" Offset="1"/>
                </RadialGradientBrush>
            </Panel.Background>

            <!-- Ambilight backdrop (blurred latest frame) + vignette -->
            <Image x:Name="AmbientImage" Stretch="UniformToFill" Opacity="0.55" IsVisible="False">
                <Image.Effect>
                    <BlurEffect Radius="90"/>
                </Image.Effect>
            </Image>
            <Border x:Name="Vignette" IsVisible="False" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="75%" RadiusY="75%">
                        <GradientStop Color="#00000000" Offset="0.45"/>
                        <GradientStop Color="#99000000" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Top screen color panel (left) -->
                <Border x:Name="AdjustTop" Grid.Column="0" IsVisible="False" Classes="adjust"
                        VerticalAlignment="Center" Margin="14,0,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Top screen" Classes="value" Margin="0,0,0,8"/>
                        <TextBlock Text="Brightness" Classes="caption"/>
                        <Slider x:Name="SldTopBright" Width="164" Minimum="-1" Maximum="1"/>
                        <TextBlock Text="Contrast" Classes="caption"/>
                        <Slider x:Name="SldTopContrast" Width="164" Minimum="0" Maximum="2"/>
                        <TextBlock Text="Saturation" Classes="caption"/>
                        <Slider x:Name="SldTopSat" Width="164" Minimum="0" Maximum="2"/>
                        <TextBlock Text="Highlights" Classes="caption"/>
                        <Slider x:Name="SldTopHi" Width="164" Minimum="0" Maximum="1" IsDirectionReversed="True"/>
                        <TextBlock Text="Shadows" Classes="caption"/>
                        <Slider x:Name="SldTopShadows" Width="164" Minimum="0" Maximum="1"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button x:Name="BtnResetTop" Classes="ghost" Content="Reset"
                                    ToolTip.Tip="Reset the top screen's color to default"/>
                            <Button x:Name="BtnCopyBottom" Classes="ghost" Content="Copy Bottom"
                                    ToolTip.Tip="Copy the bottom screen's adjustments"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Screens -->
                <Panel x:Name="ScreensHost" Grid.Column="1" Margin="28"/>

                <!-- Bottom screen color panel (right) -->
                <Border x:Name="AdjustBottom" Grid.Column="2" IsVisible="False" Classes="adjust"
                        VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Bottom screen" Classes="value" Margin="0,0,0,8"/>
                        <TextBlock Text="Brightness" Classes="caption"/>
                        <Slider x:Name="SldBotBright" Width="164" Minimum="-1" Maximum="1"/>
                        <TextBlock Text="Contrast" Classes="caption"/>
                        <Slider x:Name="SldBotContrast" Width="164" Minimum="0" Maximum="2"/>
                        <TextBlock Text="Saturation" Classes="caption"/>
                        <Slider x:Name="SldBotSat" Width="164" Minimum="0" Maximum="2"/>
                        <TextBlock Text="Highlights" Classes="caption"/>
                        <Slider x:Name="SldBotHi" Width="164" Minimum="0" Maximum="1" IsDirectionReversed="True"/>
                        <TextBlock Text="Shadows" Classes="caption"/>
                        <Slider x:Name="SldBotShadows" Width="164" Minimum="0" Maximum="1"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button x:Name="BtnResetBottom" Classes="ghost" Content="Reset"
                                    ToolTip.Tip="Reset the bottom screen's color to default"/>
                            <Button x:Name="BtnCopyTop" Classes="ghost" Content="Copy Top"
                                    ToolTip.Tip="Copy the top screen's adjustments"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pinned FPS counter (clean mode only) -->
            <Border x:Name="FpsOverlay" IsVisible="False" IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                    Background="#B0141418" CornerRadius="8" Padding="8,4">
                <TextBlock x:Name="FpsOverlayText" Text="0 / 0 fps" Classes="value"/>
            </Border>

            <!-- Transient action toast (bottom-left) -->
            <Border x:Name="Toast" IsVisible="False" IsHitTestVisible="False" MaxWidth="560"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                    Background="#F22A2438" CornerRadius="10" Padding="14,9"
                    BorderBrush="#996638D9" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" OffsetX="0" OffsetY="3" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <TextBlock x:Name="ToastText" Foreground="White" FontWeight="SemiBold" FontSize="13"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- OCR selection overlay (copy text from the screen) -->
            <Canvas x:Name="OcrOverlay" IsVisible="False" Background="#66000000" Cursor="Cross">
                <Border x:Name="OcrHint" Canvas.Left="16" Canvas.Top="14" IsVisible="False"
                        Background="#C0141418" CornerRadius="8" Padding="12,7">
                    <TextBlock Text="Drag over the text to copy  ·  Esc to cancel"
                               Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                </Border>
                <Rectangle x:Name="OcrRect" IsVisible="False"
                           Stroke="{StaticResource BrandEndBrush}" StrokeThickness="1.5" Fill="#332E7DFF"/>
            </Canvas>

            <!-- Floating restore button, shown while the control bar is hidden -->
            <Button x:Name="BtnShowBar" IsVisible="False" Classes="ghost" Content="⌃ Show bar"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                    ToolTip.Tip="Show the control bar"/>

            <!-- OCR result popup: an in-window overlay (not a separate native Window) so it stays
                 visible over native macOS fullscreen too — a floating owned Window doesn't render
                 on top of a fullscreen Space there. Anchored bottom-right; draggable from anywhere on
                 it except the editable field / buttons / toggle. -->
            <Border x:Name="OcrResultPanel" IsVisible="False" Cursor="SizeAll"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                    Background="#FF181820" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="18">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" OffsetX="0" OffsetY="8" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <StackPanel Spacing="12">
                    <TextBlock x:Name="OcrResultHeader" Text="Copied text" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBox x:Name="OcrResultBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Width="360" MinHeight="180" MaxHeight="300"
                             FontFamily="Consolas, Cascadia Mono, monospace" FontSize="14"/>
                    <Grid ColumnDefinitions="Auto,*">
                        <CheckBox x:Name="OcrHexToggle" Grid.Column="0" Content="Hex mode" FontSize="12"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Re-read the same crop, tuned for RNG-HUD seeds"/>
                        <TextBlock x:Name="OcrResultStatus" Grid.Column="1" Text="Copied to clipboard"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button x:Name="BtnOcrResultClose" Classes="ghost" Content="Close"
                                ToolTip.Tip="Close (Esc)"/>
                        <Button x:Name="BtnOcrResultCopy" Classes="brand" Content="Copy"
                                ToolTip.Tip="Copy the (possibly edited) text again"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- Control bar: today's 4 stacked rows reorganized into vertical trios placed side by side —
             everything stays visible at once (no popovers/tabs/sheet), just a lot shorter. Each column
             can collapse to its header (click it) to make room for the ones you're actually using. -->
        <Border x:Name="ControlBar" Grid.Row="1" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="10,8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#F218181F" Offset="0"/>
                    <GradientStop Color="#F20E0E13" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <WrapPanel x:Name="ColumnsHost" HorizontalAlignment="Center">

                <!-- Column: Display -->
                <Border x:Name="ColDisplay" Classes="vcol">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="GripDisplay" Text="⠿" Classes="draggrip" ToolTip.Tip="Drag to reorder"/>
                            <Button x:Name="HeadDisplay" Classes="vhead">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="ChevDisplay" Text="▾" Classes="caption"/>
                                    <TextBlock Text="DISPLAY" Classes="vheadtext"/>
                                    <TextBlock x:Name="SumDisplay" Classes="value" IsVisible="False"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="BodyDisplay" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Layout" Classes="caption" Width="42"/>
                                <ComboBox x:Name="CmbLayout" MinWidth="102" VerticalAlignment="Center"
                                          ToolTip.Tip="How the two screens are arranged (L cycles)">
                                    <ComboBoxItem>Stacked</ComboBoxItem>
                                    <ComboBoxItem>Side by side</ComboBoxItem>
                                    <ComboBoxItem>Top only</ComboBoxItem>
                                    <ComboBoxItem>Bottom only</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Filter" Classes="caption" Width="42"/>
                                <ComboBox x:Name="CmbFilter" MinWidth="102" VerticalAlignment="Center"
                                          ToolTip.Tip="Upscaling filter: Sharp / Linear / Smooth (F cycles)">
                                    <ComboBoxItem>Sharp</ComboBoxItem>
                                    <ComboBoxItem>Linear</ComboBoxItem>
                                    <ComboBoxItem>Smooth</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Rot" Classes="caption" Width="42"/>
                                <ComboBox x:Name="CmbRot" MinWidth="102" VerticalAlignment="Center"
                                          ToolTip.Tip="Rotate the screens (R cycles)">
                                    <ComboBoxItem>0°</ComboBoxItem>
                                    <ComboBoxItem>90°</ComboBoxItem>
                                    <ComboBoxItem>180°</ComboBoxItem>
                                    <ComboBoxItem>270°</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Column: Upscale & FX -->
                <Border x:Name="ColUpscale" Classes="vcol">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="GripUpscale" Text="⠿" Classes="draggrip" ToolTip.Tip="Drag to reorder"/>
                            <Button x:Name="HeadUpscale" Classes="vhead">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="ChevUpscale" Text="▾" Classes="caption"/>
                                    <TextBlock Text="UPSCALE &amp; FX" Classes="vheadtext"/>
                                    <TextBlock x:Name="SumUpscale" Classes="value" IsVisible="False"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="BodyUpscale" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Upscale" Classes="caption" Width="52"/>
                                <ComboBox x:Name="CmbUpscale" MinWidth="140" VerticalAlignment="Center"
                                          ToolTip.Tip="GPU upscaling filter. xBR/Super-xBR/ScaleFX/MMPX = pixel-art (smooth diagonals); FSR/Sharp/Anime4K = general; Anime4K CNN = neural. Falls back to CPU without a GPU (some are GPU-only).">
                                    <ComboBoxItem>None</ComboBoxItem>
                                    <ComboBoxItem>Sharp</ComboBoxItem>
                                    <ComboBoxItem>FSR</ComboBoxItem>
                                    <ComboBoxItem>Anime4K</ComboBoxItem>
                                    <ComboBoxItem>xBR</ComboBoxItem>
                                    <ComboBoxItem>Super-xBR</ComboBoxItem>
                                    <ComboBoxItem>ScaleFX</ComboBoxItem>
                                    <ComboBoxItem>MMPX</ComboBoxItem>
                                    <ComboBoxItem>Anime4K CNN</ComboBoxItem>
                                    <ComboBoxItem>Anime4K CNN M</ComboBoxItem>
                                    <ComboBoxItem>Anime4K CNN L</ComboBoxItem>
                                    <ComboBoxItem>Anime4K CNN VL</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Effect" Classes="caption" Width="52"/>
                                <ComboBox x:Name="CmbEffect" MinWidth="140" VerticalAlignment="Center"
                                          ToolTip.Tip="Display effect (GPU): a retro CRT look (scanlines + phosphor mask). Applied on its own for now.">
                                    <ComboBoxItem>None</ComboBoxItem>
                                    <ComboBoxItem>CRT</ComboBoxItem>
                                    <ComboBoxItem>CRT Dot Mask</ComboBoxItem>
                                    <ComboBoxItem>CRT Curved</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Intensity" Classes="caption" Width="52"/>
                                <Slider x:Name="SldEffectIntensity" Width="76" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                        ToolTip.Tip="Effect strength: 0 = off, 1 = full."/>
                                <TextBlock x:Name="ValEffectIntensity" Classes="value" MinWidth="30"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Column: Geometry -->
                <Border x:Name="ColGeometry" Classes="vcol">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="GripGeometry" Text="⠿" Classes="draggrip" ToolTip.Tip="Drag to reorder"/>
                            <Button x:Name="HeadGeometry" Classes="vhead">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="ChevGeometry" Text="▾" Classes="caption"/>
                                    <TextBlock Text="GEOMETRY" Classes="vheadtext"/>
                                    <TextBlock x:Name="SumGeometry" Classes="value" IsVisible="False"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="BodyGeometry" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Zoom" Classes="caption" Width="46"/>
                                <ComboBox x:Name="CmbZoom" MinWidth="96" VerticalAlignment="Center"
                                          ToolTip.Tip="Fit = fill window · % = native scale (grows the window)">
                                    <ComboBoxItem>Fit</ComboBoxItem>
                                    <ComboBoxItem>100%</ComboBoxItem>
                                    <ComboBoxItem>150%</ComboBoxItem>
                                    <ComboBoxItem>200%</ComboBoxItem>
                                    <ComboBoxItem>300%</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Gap" Classes="caption" Width="46"/>
                                <Slider x:Name="SldGap" Width="60" Minimum="0" Maximum="300" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ValGap" Classes="value" Width="22" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Top×/Bot×" Classes="caption" Width="46"/>
                                <Slider x:Name="SldTopScale" Width="36" Minimum="0.5" Maximum="2.0"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        ToolTip.Tip="Top screen scale"/>
                                <TextBlock x:Name="ValTopScale" Classes="value" Width="26" TextAlignment="Right"/>
                                <Slider x:Name="SldBottomScale" Width="36" Minimum="0.5" Maximum="2.0"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        ToolTip.Tip="Bottom screen scale"/>
                                <TextBlock x:Name="ValBottomScale" Classes="value" Width="26" TextAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Column: Capture -->
                <Border x:Name="ColCapture" Classes="vcol">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="GripCapture" Text="⠿" Classes="draggrip" ToolTip.Tip="Drag to reorder"/>
                            <Button x:Name="HeadCapture" Classes="vhead">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="ChevCapture" Text="▾" Classes="caption"/>
                                    <TextBlock Text="CAPTURE" Classes="vheadtext"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="BodyCapture" Spacing="6">
                            <Button x:Name="BtnScreenshot" Classes="ghost" Content="Screenshot" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    ToolTip.Tip="Save a screenshot (S · Shift+S copies to clipboard)"/>
                            <Button x:Name="BtnOcr" Classes="ghost" Content="Copy Text" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    ToolTip.Tip="Copy text from the stream (OCR) — drag over the text (T)"/>
                            <Button x:Name="BtnKeyboard" Classes="ghost" Content="Shortcuts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    ToolTip.Tip="View and remap keyboard shortcuts"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Column: Visual -->
                <Border x:Name="ColVisual" Classes="vcol">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="GripVisual" Text="⠿" Classes="draggrip" ToolTip.Tip="Drag to reorder"/>
                            <Button x:Name="HeadVisual" Classes="vhead">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="ChevVisual" Text="▾" Classes="caption"/>
                                    <TextBlock Text="VISUAL" Classes="vheadtext"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="BodyVisual" Spacing="6">
                            <Button x:Name="BtnAdjust" Classes="ghost" Content="Adjust" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    ToolTip.Tip="Show per-screen color adjustments"/>
                            <Button x:Name="BtnAmbient" Classes="ghost" Content="Ambient" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    ToolTip.Tip="Ambient glow behind the screens"/>
                            <Button x:Name="BtnPinFps" Classes="ghost" Content="Pin FPS" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    ToolTip.Tip="Pin the FPS counter over the screens in hide mode"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Column: Window -->
                <Border x:Name="ColWindow" Classes="vcol">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="GripWindow" Text="⠿" Classes="draggrip" ToolTip.Tip="Drag to reorder"/>
                            <Button x:Name="HeadWindow" Classes="vhead">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="ChevWindow" Text="▾" Classes="caption"/>
                                    <TextBlock Text="WINDOW" Classes="vheadtext"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="BodyWindow" Spacing="6">
                            <Button x:Name="BtnFullscreen" Classes="ghost" Content="Fullscreen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    ToolTip.Tip="Toggle fullscreen"/>
                            <Button x:Name="BtnHide" Classes="ghost" Content="Hide UI" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    ToolTip.Tip="Hide the whole interface (borderless). Esc restores it."/>
                            <Button x:Name="BtnHideBar" Classes="ghost" Content="Hide Bar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    ToolTip.Tip="Collapse this control bar (a Show bar button restores it)"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Column: Session -->
                <Border x:Name="ColSession" Classes="vcol">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="GripSession" Text="⠿" Classes="draggrip" ToolTip.Tip="Drag to reorder"/>
                            <Button x:Name="HeadSession" Classes="vhead">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="ChevSession" Text="▾" Classes="caption"/>
                                    <TextBlock Text="SESSION" Classes="vheadtext"/>
                                    <TextBlock x:Name="SumSession" Classes="value" IsVisible="False"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="BodySession" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="FPS cap" Classes="caption" Width="46"/>
                                <ComboBox x:Name="CmbMaxFps" MinWidth="70" VerticalAlignment="Center"
                                          ToolTip.Tip="Cap the frame rate (∞ = show the console's real FPS)"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Live" Classes="caption" Width="46"/>
                                <Ellipse x:Name="FpsDot" Width="8" Height="8" Fill="#888" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FpsBadge" Text="0 / 0 fps" Classes="value"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusText" Text="Streaming" Classes="caption"/>
                            <Button x:Name="BtnDisconnect" Classes="danger" Content="Disconnect" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="Disconnect and return to the menu (Esc)"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
