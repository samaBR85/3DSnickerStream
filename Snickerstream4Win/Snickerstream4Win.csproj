<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>3DSnickerStream</AssemblyName>
    <RootNamespace>Snickerstream4Win</RootNamespace>
    <ApplicationIcon>..\AppIcon.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <Product>3DSnickerStream</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- .ico for the exe, window/taskbar; high-res PNG for the in-app logo (crisp downscale). -->
    <Resource Include="..\AppIcon.ico" Link="AppIcon.ico" />
    <Resource Include="..\AppIcon-1024.png" Link="AppIcon-1024.png" />
  </ItemGroup>

</Project>
