<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>3DSnickerStream</AssemblyName>
    <RootNamespace>Snickerstream4Win</RootNamespace>
    <ApplicationIcon>..\AppIcon.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>3DSnickerStream</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single app icon used for the exe, window/taskbar, and in-app logo. -->
    <Resource Include="..\AppIcon.ico" Link="AppIcon.ico" />
  </ItemGroup>

</Project>
