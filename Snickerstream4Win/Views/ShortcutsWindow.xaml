<Window x:Class="Snickerstream4Win.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts"
        Width="520" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border Background="#FF181820" CornerRadius="16" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center"/>
                <TextBlock Text="Keyboard Shortcuts" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel x:Name="RowsPanel"/>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Button x:Name="BtnReset" Style="{StaticResource GhostButton}" Content="Reset to Defaults" HorizontalAlignment="Left"/>
                <Button x:Name="BtnDone" Style="{StaticResource AccentButton}" Content="Done" HorizontalAlignment="Right" MinWidth="90"/>
            </Grid>
        </Grid>
    </Border>
</Window>
