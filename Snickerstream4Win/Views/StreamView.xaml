<UserControl x:Class="Snickerstream4Win.Views.StreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             FontFamily="Segoe UI Variable, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="BarMdl2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- compact slider for the control bar / adjust panels -->
        <Style x:Key="MiniSlider" TargetType="Slider">
            <Setter Property="Width" Value="92"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MiniCap" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF0C0C10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Stage ===================== -->
        <Grid Grid.Row="0" ClipToBounds="True">
            <!-- Ambilight backdrop -->
            <Image x:Name="AmbientImage" Stretch="UniformToFill" Opacity="0.40">
                <Image.Effect>
                    <BlurEffect Radius="90" KernelType="Gaussian"/>
                </Image.Effect>
            </Image>
            <!-- Vignette -->
            <Border x:Name="Vignette" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#00000000" Offset="0.45"/>
                        <GradientStop Color="#99000000" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Screens + per-screen adjust panels -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Top screen adjust panel (left) -->
                <Border x:Name="AdjustTop" Grid.Column="0" Visibility="Collapsed" VerticalAlignment="Center"
                        Margin="14,0,0,0" Padding="14" CornerRadius="14" Width="170"
                        Background="#CC161620" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Top screen" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Brightness" Style="{StaticResource MiniCap}"/>
                        <Slider x:Name="SldTopBright" Style="{StaticResource MiniSlider}" Width="140" Minimum="-1" Maximum="1" Margin="0,0,0,8"/>
                        <TextBlock Text="Contrast" Style="{StaticResource MiniCap}"/>
                        <Slider x:Name="SldTopContrast" Style="{StaticResource MiniSlider}" Width="140" Minimum="0" Maximum="2" Margin="0,0,0,8"/>
                        <TextBlock Text="Saturation" Style="{StaticResource MiniCap}"/>
                        <Slider x:Name="SldTopSat" Style="{StaticResource MiniSlider}" Width="140" Minimum="0" Maximum="2" Margin="0,0,0,8"/>
                        <TextBlock Text="Highlights" Style="{StaticResource MiniCap}"/>
                        <Slider x:Name="SldTopHi" Style="{StaticResource MiniSlider}" Width="140" Minimum="0" Maximum="1" IsDirectionReversed="True" Margin="0,0,0,8"/>
                        <TextBlock Text="Shadows" Style="{StaticResource MiniCap}"/>
                        <Slider x:Name="SldTopShadows" Style="{StaticResource MiniSlider}" Width="140" Minimum="0" Maximum="1" Margin="0,0,0,4"/>
                        <Button x:Name="BtnResetTop" Style="{StaticResource GhostButton}" Content="Reset" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Screens -->
                <Grid x:Name="ScreensHost" Grid.Column="1" Margin="24"/>

                <!-- Bottom screen adjust panel (right) -->
                <Border x:Name="AdjustBottom" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center"
                        Margin="0,0,14,0" Padding="14" CornerRadius="14" Width="170"
                        Background="#CC161620" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Bottom screen" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Brightness" Style="{StaticResource MiniCap}"/>
                        <Slider x:Name="SldBotBright" Style="{StaticResource MiniSlider}" Width="140" Minimum="-1" Maximum="1" Margin="0,0,0,8"/>
                        <TextBlock Text="Contrast" Style="{StaticResource MiniCap}"/>
                        <Slider x:Name="SldBotContrast" Style="{StaticResource MiniSlider}" Width="140" Minimum="0" Maximum="2" Margin="0,0,0,8"/>
                        <TextBlock Text="Saturation" Style="{StaticResource MiniCap}"/>
                        <Slider x:Name="SldBotSat" Style="{StaticResource MiniSlider}" Width="140" Minimum="0" Maximum="2" Margin="0,0,0,8"/>
                        <TextBlock Text="Highlights" Style="{StaticResource MiniCap}"/>
                        <Slider x:Name="SldBotHi" Style="{StaticResource MiniSlider}" Width="140" Minimum="0" Maximum="1" IsDirectionReversed="True" Margin="0,0,0,8"/>
                        <TextBlock Text="Shadows" Style="{StaticResource MiniCap}"/>
                        <Slider x:Name="SldBotShadows" Style="{StaticResource MiniSlider}" Width="140" Minimum="0" Maximum="1" Margin="0,0,0,4"/>
                        <Button x:Name="BtnResetBottom" Style="{StaticResource GhostButton}" Content="Reset" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== Control bar ===================== -->
        <Border x:Name="ControlBar" Grid.Row="1" MinHeight="56" Background="#E6141418"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDisconnect" Style="{StaticResource DangerButton}" Margin="0,3,0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BarMdl2}" Text="&#xE71A;" Margin="0,0,6,0"/>
                            <TextBlock Text="Disconnect"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="26" Background="{StaticResource CardBorderBrush}" Margin="12,0"/>

                    <TextBlock Text="Layout" Style="{StaticResource MiniCap}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbLayout" MinWidth="110" Margin="0,3">
                        <ComboBoxItem Content="Stacked"/>
                        <ComboBoxItem Content="Side by side"/>
                        <ComboBoxItem Content="Top only"/>
                        <ComboBoxItem Content="Bottom only"/>
                    </ComboBox>

                    <TextBlock Text="Filter" Style="{StaticResource MiniCap}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbFilter" MinWidth="90" Margin="0,3">
                        <ComboBoxItem Content="Sharp"/>
                        <ComboBoxItem Content="Linear"/>
                        <ComboBoxItem Content="Smooth"/>
                    </ComboBox>

                    <TextBlock Text="Rot" Style="{StaticResource MiniCap}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbRotation" MinWidth="72" Margin="0,3">
                        <ComboBoxItem Content="0°"/>
                        <ComboBoxItem Content="90°"/>
                        <ComboBoxItem Content="180°"/>
                        <ComboBoxItem Content="270°"/>
                    </ComboBox>

                    <TextBlock Text="FPS" Style="{StaticResource MiniCap}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbMaxFps" MinWidth="72" Margin="0,3"/>

                    <Border Width="1" Height="26" Background="{StaticResource CardBorderBrush}" Margin="12,0"/>

                    <TextBlock Text="Zoom" Style="{StaticResource MiniCap}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbZoom" MinWidth="76" Margin="0,3">
                        <ComboBoxItem Content="Fit"/>
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="150%"/>
                        <ComboBoxItem Content="200%"/>
                        <ComboBoxItem Content="300%"/>
                    </ComboBox>

                    <TextBlock Text="Gap" Style="{StaticResource MiniCap}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                    <Slider x:Name="SldGap" Style="{StaticResource MiniSlider}" Minimum="0" Maximum="300"/>
                    <TextBlock x:Name="ValGap" Style="{StaticResource MiniCap}" Width="30" Margin="4,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Text="Top×" Style="{StaticResource MiniCap}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                    <Slider x:Name="SldTopScale" Style="{StaticResource MiniSlider}" Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="ValTopScale" Style="{StaticResource MiniCap}" Width="34" Margin="4,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Text="Bot×" Style="{StaticResource MiniCap}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                    <Slider x:Name="SldBottomScale" Style="{StaticResource MiniSlider}" Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="ValBottomScale" Style="{StaticResource MiniCap}" Width="34" Margin="4,0,0,0" VerticalAlignment="Center"/>

                    <Border Width="1" Height="26" Background="{StaticResource CardBorderBrush}" Margin="12,0"/>
                    <Button x:Name="BtnAdjust" Style="{StaticResource GhostButton}" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BarMdl2}" Text="&#xE790;" Margin="0,0,6,0"/>
                            <TextBlock Text="Ajustes"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAmbient" Style="{StaticResource IconButton}" Margin="8,3,0,3" ToolTip="Ambient glow">
                        <TextBlock Style="{StaticResource BarMdl2}" Text="&#xE945;"/>
                    </Button>
                    <Button x:Name="BtnKeyboard" Style="{StaticResource IconButton}" Margin="8,3,0,3" ToolTip="Keyboard shortcuts">
                        <TextBlock Style="{StaticResource BarMdl2}" Text="&#xE765;"/>
                    </Button>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="FpsDot" Width="9" Height="9" Fill="#888" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FpsBadge" Text="0 / 0 fps" Style="{StaticResource ValueText}" Margin="8,0,0,0"/>
                    <Border Width="1" Height="20" Background="{StaticResource CardBorderBrush}" Margin="12,0"/>
                    <TextBlock x:Name="StatusText" Text="Streaming" Style="{StaticResource CaptionText}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
